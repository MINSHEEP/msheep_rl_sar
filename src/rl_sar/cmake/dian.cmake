option(BUILD_DIAN "Build DIAN RS03 deployment" ${BUILD_DIAN_ONLY})
if(BUILD_DIAN)
    if(NOT USE_ONNX)
        message(FATAL_ERROR "DIAN requires ONNX Runtime: bash scripts/download_inference_runtime.sh onnx")
    endif()
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "DIAN hardware target currently requires Linux")
    endif()
    find_package(Eigen3 REQUIRED)
    add_library(dian_imu library/robot_sdk/dian/hipnuc/custom_quad_imu.cpp
                         library/robot_sdk/dian/hipnuc/custom_quad_imu_serial.cpp)
    target_include_directories(dian_imu PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/library/robot_sdk/dian/hipnuc)
    target_link_libraries(dian_imu PUBLIC ${YAML_CPP_LIBRARIES})
    add_library(dian_sdk INTERFACE)
    target_include_directories(dian_sdk INTERFACE ${CMAKE_CURRENT_SOURCE_DIR}/library/robot_sdk/dian)
    target_link_libraries(dian_sdk INTERFACE dian_imu Eigen3::Eigen ${YAML_CPP_LIBRARIES} observation_buffer Threads::Threads)
    add_executable(rl_real_dian src/rl_real_dian.cpp)
    target_link_libraries(rl_real_dian PRIVATE rl_sdk dian_sdk)
    enable_testing()
    add_executable(test_dian tests/test_dian.cpp)
    target_link_libraries(test_dian PRIVATE dian_sdk)
    add_test(NAME dian_contract COMMAND test_dian ${PROJECT_ROOT_DIR}/policy)
    add_executable(test_dian_imu tests/test_dian_imu.cpp)
    target_link_libraries(test_dian_imu PRIVATE dian_imu)
    add_test(NAME dian_imu COMMAND test_dian_imu)
    add_executable(test_dian_227 tests/test_dian_227.cpp)
    target_link_libraries(test_dian_227 PRIVATE dian_sdk)
    add_test(NAME dian_227_contract COMMAND test_dian_227 ${PROJECT_ROOT_DIR}/policy ${CMAKE_CURRENT_SOURCE_DIR}/tests/dian_227_reference.yaml)
    add_executable(test_dian_gamepad tests/test_dian_gamepad.cpp)
    target_link_libraries(test_dian_gamepad PRIVATE dian_sdk)
    add_test(NAME dian_gamepad COMMAND test_dian_gamepad)
    add_executable(test_dian_fsm tests/test_dian_fsm.cpp src/rl_real_dian.cpp)
    target_compile_definitions(test_dian_fsm PRIVATE DIAN_LIBRARY_ONLY)
    target_link_libraries(test_dian_fsm PRIVATE rl_sdk dian_sdk)
    add_test(NAME dian_fsm COMMAND test_dian_fsm ${PROJECT_ROOT_DIR}/policy ${CMAKE_CURRENT_SOURCE_DIR}/tests/zero_actor_227.onnx)
    add_executable(test_dian_keyboard tests/test_dian_keyboard.cpp)
    target_link_libraries(test_dian_keyboard PRIVATE dian_sdk)
    add_test(NAME dian_keyboard COMMAND test_dian_keyboard)
    add_test(NAME dian_keyboard_terminal COMMAND ${Python3_EXECUTABLE}
        ${CMAKE_CURRENT_SOURCE_DIR}/tests/test_dian_keyboard_terminal.py $<TARGET_FILE:rl_real_dian>
        ${PROJECT_ROOT_DIR}/policy ${CMAKE_CURRENT_SOURCE_DIR}/tests/zero_actor_227.onnx)
    set_tests_properties(dian_keyboard_terminal PROPERTIES TIMEOUT 30)
endif()
